{
  "name": "loopy-guide",
  "private": true,
  "type": "module",
  "description": "The loopy guide: how to use loopy, in English and German. Built with Astro and Starlight.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/finish.mjs && python3 ../tools/csp.py",
    "screens": "node scripts/screens.mjs",
    "prebuild": "cp ../icon.svg public/favicon.svg",
    "predev": "cp ../icon.svg public/favicon.svg",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
