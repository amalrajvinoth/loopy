{
  "name": "loopy-guide",
  "private": true,
  "type": "module",
  "description": "The loopy guide: how to use loopy, in English and German. Built with Astro and Starlight.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/finish.mjs && python3 ../tools/csp.py",
    "screens": "node scripts/screens.mjs",
    "prebuild": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync('../icon.svg','public/favicon.svg')\"",
    "predev": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync('../icon.svg','public/favicon.svg')\"",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.2",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
