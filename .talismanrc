# Talisman (the commit hook that looks for secrets) reads loopy's Content-Security-Policy hashes as
# base64 secrets. They are hashes of the page's own script and style, not secrets.
allowed_patterns:
  - "sha256-[A-Za-z0-9+/=]{43,44}"

# The owner asked (17 Nov 2026): low-severity guesses fire on plain sentences (a game's "keys"), so
# only medium and high stop a commit.
threshold: medium
version: "1.0"
